# Aurum Vision — environment variables
#
# Copy to .env and fill in. `.env` is gitignored; never commit real values.
#   cp env.example .env
#
# Nothing here is needed to RUN the demo or the API against existing weights.
# These are only required to rebuild the dataset or retrain.

# ---------------------------------------------------------------------------
# Dataset ingest (required only for `python -m ml.ingest`)
# ---------------------------------------------------------------------------
# Free key from roboflow.com -> Settings -> API Keys. Universe datasets are
# public, but the download endpoint requires a key.
ROBOFLOW_API_KEY=

# ---------------------------------------------------------------------------
# Optional: contact address sent in the User-Agent when fetching the external
# evaluation images from Wikimedia Commons. Their robot policy asks for a
# contact route. Falls back to a generic agent if unset.
# ---------------------------------------------------------------------------
AURUM_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# LIVE METAL PRICES - MetalpriceAPI (required only for pricing.provider:
# metalprice; without it Aurum uses the dated REFERENCE snapshot instead).
#
# Free key from metalpriceapi.com. THIS IS THE ONE SETTING THAT IS NOT IN
# app/config.py: it is read straight from the environment by config.secret()
# so it can never be serialised out of a Config object. Never commit it and
# never send it to the browser.
# ---------------------------------------------------------------------------
AURUM_METALPRICE_API_KEY=

# ---------------------------------------------------------------------------
# Optional: training overrides (all have working defaults, see docs/training.md)
# ---------------------------------------------------------------------------
# AURUM_MODEL=yolo11n.pt
# AURUM_EPOCHS=50
# AURUM_IMGSZ=512
# AURUM_BATCH=32
# AURUM_PATIENCE=15
# AURUM_SEED=1337
# AURUM_WORKERS=4
# AURUM_DEVICE=mps          # mps | cpu | 0 (cuda index); auto-detected if unset
# AURUM_RUN=aurum_vision_v0_1

# ---------------------------------------------------------------------------
# Optional: real HX711 load cell. If unset, the dashboard uses a clearly
# labelled SIMULATED sensor and never presents it as a measurement.
# ---------------------------------------------------------------------------
# AURUM_HX711_PORT=/dev/tty.usbmodem1101

# ===========================================================================
# Conveyor and grading (app/config.py)
#
# Precedence: shipped defaults, then configs/conveyor.yaml and
# configs/grading.yaml, then anything exported here. The environment wins.
# Everything below is optional; the YAML files already carry working values.
#
# UNMEASURED is a legal value and means exactly what it says. Anything left
# unmeasured makes the routing layer refuse to schedule, so items fall through
# to Bin C rather than being routed by a guess.
# ===========================================================================

# --- camera ---------------------------------------------------------------
# AURUM_CAMERA_INDEX=0
# AURUM_CAMERA_BACKEND=auto     # auto | CAP_DSHOW (Win) | CAP_AVFOUNDATION (mac)
# AURUM_CAMERA_WIDTH=1280
# AURUM_CAMERA_HEIGHT=720

# --- detection ------------------------------------------------------------
# AURUM_DETECTION_CONFIDENCE=0.35
# AURUM_DETECTION_IOU=0.5

# --- belt and geometry: MEASURE THESE ON THE REAL MACHINE -----------------
# AURUM_BELT_SPEED_CM_S=UNMEASURED
# AURUM_CAMERA_TO_LOAD_CELL_CM=UNMEASURED
# AURUM_CAMERA_TO_SERVO_A_CM=UNMEASURED
# AURUM_CAMERA_TO_SERVO_B_CM=UNMEASURED
# AURUM_SERVO_ACTUATION_DELAY_MS=UNMEASURED
# AURUM_TIMING_OFFSET_MS=0      # calibration knob; negative fires earlier

# --- load cell ------------------------------------------------------------
# AURUM_WEIGHT_STABILITY_WINDOW_MS=500
# AURUM_WEIGHT_STABILITY_TOLERANCE_G=0.5
# AURUM_WEIGHT_TIMEOUT_S=5.0
# AURUM_WEIGHT_CALIBRATION_FACTOR=UNMEASURED

# --- Arduino --------------------------------------------------------------
# AURUM_ARDUINO_PORT=            # COM3 on Windows, /dev/ttyACM0 on Linux
# AURUM_ARDUINO_BAUDRATE=9600
# AURUM_ARDUINO_TIMEOUT_S=1.0
# AURUM_ARDUINO_ACK_TIMEOUT_MS=500

# --- runtime --------------------------------------------------------------
# AURUM_SIMULATION=false         # true runs the pipeline with no hardware
# AURUM_HOST=127.0.0.1
# AURUM_PORT=8000

# --- grading: ENGINEERING APPROXIMATIONS, not research-derived ------------
# See configs/grading.yaml for the rationale behind each number.
# AURUM_BIN_A_MIN_PRECIOUS_PPM=1000
# AURUM_BIN_A_MIN_CONFIDENCE=0.75
# AURUM_BIN_A_MIN_PRECIOUS_VALUE=UNMEASURED
# AURUM_BIN_A_PREFERRED_CLASSES=CPU,Connector
# AURUM_BIN_B_MIN_PRECIOUS_PPM=100
# AURUM_BIN_B_MIN_CONFIDENCE=0.60
# AURUM_GRADING_FALLBACK=C
# AURUM_GRADING_CLASS_AWARE=true
# AURUM_PRICE_UNAVAILABLE_POLICY=mass_fraction_only   # or route_to_c

# --- pricing --------------------------------------------------------------
# AURUM_PRICE_PROVIDER=reference     # reference | metalprice | unavailable | static
# AURUM_PRICE_CURRENCY=INR
# AURUM_PRICE_MAX_AGE_SECONDS=900    # a LIVE quote older than this is STALE
# AURUM_PRICE_FALLBACK_TO_REFERENCE=true
# AURUM_METALPRICE_BASE=USD
# AURUM_METALPRICE_BASE_URL=https://api.metalpriceapi.com/v1
# AURUM_METALPRICE_TIMEOUT_S=5.0
# AURUM_METALPRICE_CACHE_SECONDS=900
