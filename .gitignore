# Environments
.venv/
env/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Secrets — never commit. The committed template is env.example (no leading
# dot), which these patterns do not match, so it stays tracked.
.env
.env.*

# Datasets are rebuilt from configs/datasets.yaml via `python -m ml.ingest`.
# They are large and carry third-party licenses; not redistributed here.
data/raw/
data/interim/
data/aurum/
data/realworld/
data/batches/
data/*.db

# Vision failure frames captured off a running machine (tracking.capture.*).
# Real photographs of a real bench, written by the thousand when capture is on,
# and turned into a FiftyOne dataset locally. See docs/vision-qa.md.
data/vision_errors/

# Training runs. Curated outputs are copied into models/ and reports/.
runs/

# Model weights are build artifacts. See docs/model-card.md for how to obtain
# or rebuild them; yolo11n.pt is auto-downloaded by Ultralytics on first train.
*.pt

# Generated inference outputs
reports/realworld/
reports/realworld_relaxed/
reports/test_predictions/

.DS_Store
node_modules/
dist/
