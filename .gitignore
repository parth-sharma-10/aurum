# Environments
.venv/
env/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Secrets — never commit. The committed template is env.example (no leading
# dot), which these patterns do not match, so it stays tracked.
.env
.env.*

# Datasets are rebuilt from configs/datasets.yaml via `python -m ml.ingest`.
# They are large and carry third-party licenses; not redistributed here.
data/raw/
data/interim/
data/aurum/
data/realworld/
data/batches/
data/*.db

# Vision failure frames captured off a running machine (tracking.capture.*).
# Real photographs of a real bench, written by the thousand when capture is on,
# and turned into a FiftyOne dataset locally. See docs/vision-qa.md.
data/vision_errors/

# Training runs. Curated outputs are copied into models/ and reports/.
runs/

# Model weights are build artifacts. See docs/model-card.md for how to obtain
# or rebuild them; yolo11n.pt is auto-downloaded by Ultralytics on first train.
*.pt

# Generated inference outputs. The annotated JPEGs are rebuilt by re-running
# ml.realworld / ml.evaluate against the weights named in the summary; the
# *_summary.json and *_metrics.json files beside them ARE tracked, because they
# are the evidence and they are small.
reports/realworld/
reports/realworld_relaxed/
reports/realworld_v1/
reports/realworld_v2/
reports/test_predictions/
reports/test_predictions_v0_1/
reports/bench_perfboard/
reports/bench_perfboard_v0_1/
reports/bench_perfboard_v0_2/
reports/bench_broken_pcb_v0_1/
reports/bench_broken_pcb_v0_2/
reports/bench_empty_v0_1/
reports/bench_empty_v0_2/
reports/bench_heldout_boardlike_v0_1/
reports/bench_heldout_boardlike_v0_2/
reports/bench_real_cpu_v0_1/
reports/bench_real_cpu_v0_2/
reports/bench_labels/
reports/hardneg_review/

.DS_Store
node_modules/
dist/
